---
// LandingCard — v2 with standard + featured variants
export interface Props {
  title: string;
  description: string;
  href: string;
  readingTime: number;
  category: string;
  hero?: string;
  featured?: boolean;
}
const { title, description, href, readingTime, category, hero, featured = false } = Astro.props;
---

<a href={href} class={featured ? 'card card-featured' : 'card'}>
  {hero && (
    <div class="card-hero" aria-hidden="true">
      <img src={hero} alt="" loading="lazy" />
    </div>
  )}
  <div class="card-body">
    <div class="card-meta">
      <span class="card-cat">{category}</span>
      <span class="card-time">{readingTime} min</span>
    </div>
    {featured && <span class="card-badge">Najnowszy</span>}
    <h3 class="card-title">{title}</h3>
    <p class="card-desc">{description}</p>
    <span class="card-cta">
      Czytaj poradnik
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14M13 5l7 7-7 7"/>
      </svg>
    </span>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform 0.18s var(--ease-out), box-shadow 0.18s var(--ease-out), border-color 0.18s var(--ease-out);
    height: 100%;
    color: inherit;
  }

  .card:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 30px rgba(26, 26, 26, 0.11);
    border-color: var(--ink);
    color: inherit;
  }

  .card-hero {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--cream-strong);
  }

  .card-hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .card-body {
    padding: 18px 22px 22px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }

  .card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .card-cat { color: var(--orange); }
  .card-time { color: var(--text-quiet); }

  .card-badge {
    align-self: flex-start;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--orange-dark);
    background: var(--orange-tint);
    padding: 4px 10px;
    border-radius: 4px;
  }

  .card-title {
    font-size: 19px;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.2px;
    color: var(--ink);
    text-wrap: pretty;
  }

  .card-desc {
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-muted);
    text-wrap: pretty;
    flex-grow: 1;
  }

  .card-cta {
    margin-top: auto;
    padding-top: 14px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 500;
    color: var(--ink);
  }

  .card:hover .card-cta { color: var(--orange-dark); }

  /* ============ Featured variant ============ */

  .card-featured {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(300px, 1fr) minmax(300px, 1fr);
    gap: 0;
  }

  .card-featured .card-hero {
    aspect-ratio: auto;
    min-height: 300px;
    height: 100%;
  }

  .card-featured .card-body {
    padding: 34px 36px;
    justify-content: center;
    gap: 14px;
  }

  .card-featured .card-title {
    font-size: 28px;
    line-height: 1.18;
    letter-spacing: -0.7px;
    font-weight: 600;
  }

  .card-featured .card-desc {
    font-family: var(--font-serif);
    font-size: 17px;
    line-height: 1.55;
    color: var(--text-warm);
    flex-grow: 0;
  }

  .card-featured .card-cta {
    align-self: flex-start;
    padding: 12px 22px;
    background: var(--ink);
    color: var(--white);
    border-radius: var(--radius);
    font-weight: 500;
    margin-top: 6px;
  }

  .card-featured:hover .card-cta {
    background: var(--orange);
    color: var(--ink);
  }

  @media (max-width: 780px) {
    .card-featured { grid-template-columns: 1fr; }
    .card-featured .card-hero { min-height: 200px; aspect-ratio: 16 / 9; }
    .card-featured .card-body { padding: 22px; }
    .card-featured .card-title { font-size: 22px; }
    .card-featured .card-desc { font-size: 15px; }
  }
</style>
