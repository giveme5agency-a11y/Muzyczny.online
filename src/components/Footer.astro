---
const cols = [
  {
    title: 'Poradniki',
    links: [
      { label: 'Dla dzieci', href: '/instrumenty-muzyczne-dla-dzieci/' },
      { label: 'Używane', href: '/instrumenty-muzyczne-uzywane/' },
      { label: 'Akustyczne', href: '/instrumenty-muzyczne-akustyczne/' },
      { label: 'Profesjonalne', href: '/instrumenty-muzyczne-profesjonalne/' },
    ],
  },
  {
    title: 'Kategorie',
    links: [
      { label: 'Wszystkie poradniki', href: '/poradniki/' },
      { label: 'Wg wieku', href: '/kategorie/wiek/' },
      { label: 'Wg budżetu', href: '/kategorie/budzet/' },
      { label: 'Wg poziomu', href: '/kategorie/poziom/' },
    ],
  },
  {
    title: 'Sklep',
    links: [
      { label: 'muzyczny.pl', href: 'https://muzyczny.pl' },
      { label: 'Kontakt', href: '/kontakt/' },
      { label: 'O nas', href: '/o-nas/' },
    ],
  },
];
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-brand">
      <div class="footer-logo">
        <span>muzyczny.online</span>
      </div>
      <p class="footer-tag">
        Poradniki i przewodniki zakupowe po instrumentach muzycznych.
        Serwis siostrzany sklepu muzyczny.pl.
      </p>
    </div>

    <div class="footer-cols">
      {cols.map((col) => (
        <div class="footer-col">
          <h3>{col.title}</h3>
          <ul>
            {col.links.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>

  <div class="footer-legal">
    <div class="wrap footer-legal-inner">
      <span>© {new Date().getFullYear()} muzyczny.pl · Wszystkie prawa zastrzeżone</span>
      <span>
        <a href="/polityka-prywatnosci/">Polityka prywatności</a>
        <span class="sep">·</span>
        <a href="/regulamin/">Regulamin</a>
      </span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: #C9C9C9;
    margin-top: 80px;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 60px;
    padding: 56px 20px 40px;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--white);
    font-weight: 700;
    font-size: 15px;
    margin-bottom: 12px;
  }

  .footer-tag {
    font-size: 13px;
    line-height: 1.6;
    color: #8A8A8A;
    max-width: 320px;
  }

  .footer-cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  .footer-col h3 {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--white);
    margin-bottom: 16px;
    font-weight: 600;
  }

  .footer-col ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-col a {
    font-size: 14px;
    color: #B0B0B0;
    transition: color 0.15s;
  }

  .footer-col a:hover { color: var(--orange); }

  .footer-legal {
    border-top: 1px solid #2E2E2E;
  }

  .footer-legal-inner {
    display: flex;
    justify-content: space-between;
    padding: 18px 20px;
    font-size: 12px;
    color: #8A8A8A;
  }

  .footer-legal a { color: #8A8A8A; }
  .footer-legal a:hover { color: var(--orange); }
  .sep { margin: 0 8px; opacity: 0.5; }

  @media (max-width: 780px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 32px;
      padding: 40px 16px 24px;
    }
    .footer-cols {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
    .footer-legal-inner {
      flex-direction: column;
      gap: 10px;
      align-items: flex-start;
    }
  }
</style>
