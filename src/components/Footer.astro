---
// Footer — v2 layout, muzyczny.pl references removed
const cols = [
  {
    title: 'Poradniki',
    links: [
      { label: 'Dla dzieci', href: '/instrumenty-muzyczne-dla-dzieci/' },
      { label: 'Używane', href: '/instrumenty-muzyczne-uzywane/' },
      { label: 'Akustyczne', href: '/instrumenty-muzyczne-akustyczne/' },
      { label: 'Ukulele', href: '/jak-wybrac-pierwsze-ukulele/' },
    ],
  },
  {
    title: 'Kategorie',
    links: [
      { label: 'Wszystkie poradniki', href: '/poradniki/' },
      { label: 'Wg wieku', href: '/kategorie/wiek/' },
      { label: 'Wg budżetu', href: '/kategorie/budzet/' },
      { label: 'Wg poziomu', href: '/kategorie/poziom/' },
    ],
  },
  {
    title: 'Serwis',
    links: [
      { label: 'Kontakt', href: '/kontakt/' },
      { label: 'O nas', href: '/o-nas/' },
    ],
  },
];
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-brand">
      <div class="footer-logo">muzyczny.online</div>
      <p class="footer-tag">
        Poradniki i przewodniki zakupowe po instrumentach muzycznych.
      </p>
    </div>

    {cols.map((col) => (
      <div class="footer-col">
        <div class="footer-col-title">{col.title}</div>
        <div class="footer-col-links">
          {col.links.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
        </div>
      </div>
    ))}
  </div>

  <div class="wrap">
    <div class="footer-legal">
      <span>© {new Date().getFullYear()} muzyczny.online · Wszystkie prawa zastrzeżone</span>
      <span>
        <a href="/polityka-prywatnosci/">Polityka prywatności</a>
        <span class="sep">·</span>
        <a href="/regulamin/">Regulamin</a>
      </span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: #B8B8B8;
    margin-top: 80px;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) repeat(3, minmax(0, 1fr));
    gap: 40px;
    padding: 62px 20px 0;
  }

  .footer-logo {
    font-size: 16px;
    font-weight: 700;
    color: var(--white);
  }

  .footer-tag {
    margin-top: 16px;
    max-width: 320px;
    font-size: 13px;
    line-height: 1.7;
    color: var(--text-quiet);
    text-wrap: pretty;
  }

  .footer-col-title {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--white);
  }

  .footer-col-links {
    margin-top: 18px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    font-size: 14px;
  }

  .footer-col-links a {
    color: #B8B8B8;
  }

  .footer-col-links a:hover { color: var(--orange); }

  .footer-legal {
    margin-top: 54px;
    padding: 24px 0 30px;
    border-top: 1px solid var(--ink-soft);
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
    justify-content: space-between;
    font-size: 13px;
    color: var(--text-muted);
  }

  .footer-legal a { color: var(--text-muted); }
  .footer-legal a:hover { color: var(--orange); }
  .sep { margin: 0 8px; opacity: 0.5; }

  @media (max-width: 780px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 32px;
      padding: 40px 16px 0;
    }
  }
</style>
