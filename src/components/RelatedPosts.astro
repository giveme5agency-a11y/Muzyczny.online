---
export interface RelatedPost {
  title: string;
  href: string;
  category: string;
  readingTime: number;
}
export interface Props { posts: RelatedPost[]; }
const { posts } = Astro.props;
---

{posts.length > 0 && (
  <section class="related" aria-label="Powiązane poradniki">
    <div class="related-label">Powiązane poradniki</div>
    <div class="related-grid">
      {posts.map((post) => (
        <a href={post.href} class="related-card">
          <span class="related-meta">{post.category} · {post.readingTime} min</span>
          <span class="related-title">{post.title}</span>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .related {
    max-width: var(--container-narrow);
    margin: 0 auto;
    padding: 52px 20px 0;
  }

  .related-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .related-grid {
    margin-top: 16px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
  }

  .related-card {
    display: block;
    padding: 18px 20px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--white);
    transition: border-color 0.15s var(--ease-out), transform 0.15s var(--ease-out);
    color: inherit;
  }

  .related-card:hover {
    border-color: var(--ink);
    transform: translateY(-2px);
    color: inherit;
  }

  .related-meta {
    display: block;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--orange-dark);
  }

  .related-title {
    display: block;
    margin-top: 8px;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.2px;
    color: var(--ink);
    text-wrap: pretty;
  }
</style>
