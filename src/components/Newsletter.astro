---
// Newsletter — mirrors the "ZAPISZ SIĘ DO NASZEGO NEWSLETTERA"
// section from muzyczny.net but repositioned around content, not promos.
---

<section class="newsletter">
  <div class="wrap newsletter-inner">
    <div class="newsletter-text">
      <h2>Nowy poradnik co dwa tygodnie</h2>
      <p>
        Dostajesz krótkiego maila z jednym praktycznym poradnikiem —
        jak wybrać instrument, na co uważać, ile realnie kosztuje.
        Zero spamu, zero reklam.
      </p>
    </div>
    <form class="newsletter-form" action="#" method="post" onsubmit="return false">
      <input type="email" placeholder="twoj@email.pl" aria-label="Adres email" required />
      <button type="submit" class="btn btn-primary">Zapisz mnie</button>
      <label class="newsletter-consent">
        <input type="checkbox" required />
        <span>Wyrażam zgodę na przetwarzanie moich danych zgodnie z <a href="/polityka-prywatnosci/">polityką prywatności</a>.</span>
      </label>
    </form>
  </div>
</section>

<style>
  .newsletter {
    background: var(--ink);
    color: var(--white);
    padding: 64px 0;
    position: relative;
    overflow: hidden;
  }

  .newsletter::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 15% 30%, rgba(245, 143, 0, 0.15) 0%, transparent 40%),
      radial-gradient(circle at 85% 70%, rgba(245, 143, 0, 0.08) 0%, transparent 40%);
    pointer-events: none;
  }

  .newsletter-inner {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }

  .newsletter-text h2 {
    font-size: 28px;
    font-weight: 600;
    line-height: 1.25;
    margin: 0 0 12px;
    color: var(--white);
  }

  .newsletter-text p {
    font-size: 15px;
    line-height: 1.6;
    color: #B8B8B8;
    max-width: 420px;
  }

  .newsletter-form {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 10px;
  }

  .newsletter-form input[type="email"] {
    padding: 14px 16px;
    font-size: 14px;
    background: rgba(255, 255, 255, 0.06);
    color: var(--white);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: var(--radius);
    font-family: inherit;
    outline: none;
    transition: border-color 0.15s;
  }

  .newsletter-form input[type="email"]::placeholder { color: #6A6A6A; }
  .newsletter-form input[type="email"]:focus { border-color: var(--orange); }

  .newsletter-consent {
    grid-column: 1 / -1;
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 11px;
    color: #8A8A8A;
    line-height: 1.5;
    margin-top: 4px;
  }

  .newsletter-consent input { margin-top: 3px; }
  .newsletter-consent a { color: var(--orange); text-decoration: underline; }

  @media (max-width: 780px) {
    .newsletter { padding: 48px 0; }
    .newsletter-inner { grid-template-columns: 1fr; gap: 24px; }
    .newsletter-text h2 { font-size: 22px; }
  }
</style>
