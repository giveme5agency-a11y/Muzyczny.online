---
// Header — visually related to muzyczny.net but repositioned for a content hub:
// same orange logo mark, but nav = poradniki (guides), not product categories.
const nav = [
  { label: 'Poradniki', href: '/poradniki/' },
  { label: 'Kategorie', href: '/kategorie/' },
  { label: 'O nas', href: '/o-nas/' },
];
---

<header class="site-header">
  <div class="wrap header-inner">
    <a href="/" class="brand" aria-label="muzyczny.online — strona główna">
      <span class="brand-text">
        <span class="brand-primary">muzyczny</span><span class="brand-accent">.online</span>
      </span>
      <span class="brand-tag">poradniki</span>
    </a>

    <nav class="site-nav" aria-label="Główna nawigacja">
      {nav.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>

    <a href="https://muzyczny.pl" class="shop-link" rel="noopener">
      <span>Sklep muzyczny.pl</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M7 17L17 7M17 7H8M17 7v9"/>
      </svg>
    </a>
  </div>
</header>

<style>
  .site-header {
    background: var(--white);
    border-bottom: 1px solid var(--line);
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: saturate(180%) blur(6px);
    background: rgba(255, 255, 255, 0.94);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: 68px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .brand-mark {
    display: block;
    line-height: 0;
  }

  .brand-text {
    font-weight: 700;
    font-size: 16px;
    letter-spacing: -0.01em;
    color: var(--ink);
    display: flex;
    align-items: baseline;
  }

  .brand-primary { color: var(--ink); }
  .brand-secondary { color: var(--ink); }
  .brand-accent { color: var(--orange); }

  .brand-tag {
    margin-left: 8px;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    padding: 3px 8px;
    border: 1px solid var(--line);
    border-radius: 3px;
  }

  .site-nav {
    display: flex;
    gap: 32px;
    font-size: 14px;
    font-weight: 500;
  }

  .site-nav a {
    color: var(--ink);
    position: relative;
    padding: 6px 0;
    transition: color 0.15s;
  }

  .site-nav a:hover { color: var(--orange); }

  .shop-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 500;
    color: var(--ink);
    padding: 8px 14px;
    background: var(--cream);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    transition: background 0.15s, color 0.15s;
  }

  .shop-link:hover {
    background: var(--orange);
    border-color: var(--orange);
    color: var(--ink);
  }

  @media (max-width: 780px) {
    .site-nav, .brand-tag { display: none; }
    .header-inner { height: 60px; }
    .brand-text { font-size: 14px; }
    .shop-link span { display: none; }
  }
</style>
