---
// Header — v2 layout, muzyczny.pl name/link removed
// "Sklep" pill is now a non-navigating span (per user request)
const nav = [
  { label: 'Poradniki', href: '/poradniki/' },
  { label: 'Kategorie', href: '/kategorie/' },
  { label: 'O nas', href: '/o-nas/' },
];
---

<header class="site-header">
  <div class="wrap header-inner">
    <a href="/" class="brand" aria-label="muzyczny.online — strona główna">
      <span class="brand-text">
        muzyczny.<span class="brand-accent">online</span>
      </span>
      <span class="brand-tag">Poradniki</span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Menu" />
    <label for="nav-toggle" class="nav-btn" aria-hidden="true">
      <span></span><span></span><span></span>
    </label>

    <nav class="site-nav" aria-label="Główna nawigacja">
      {nav.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>

    <span class="shop-pill" aria-label="Sklep">Sklep</span>
  </div>
</header>

<style>
  .site-header {
    background: var(--white);
    border-bottom: 1px solid var(--line);
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: saturate(180%) blur(6px);
    background: rgba(255, 255, 255, 0.94);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 16px;
    height: 66px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .brand-text {
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.2px;
    color: var(--ink);
  }

  .brand-accent { color: var(--orange); }

  .brand-tag {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    padding: 3px 7px;
    border: 1px solid var(--line);
    border-radius: 4px;
  }

  .site-nav {
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 30px;
    font-size: 14px;
  }

  .site-nav a {
    padding: 6px 0;
    color: var(--text);
  }

  .shop-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 500;
    color: var(--ink);
    background: var(--cream);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 10px 16px;
    cursor: default;
  }

  /* Mobile menu */
  .nav-toggle { display: none; }
  .nav-btn { display: none; }

  @media (max-width: 780px) {
    .header-inner { gap: 12px; }
    .brand-tag { display: none; }
    .brand-text { font-size: 16px; }
    .shop-pill { padding: 9px 14px; font-size: 12px; }

    .nav-btn {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 4px;
      width: 44px;
      height: 44px;
      margin-left: auto;
      cursor: pointer;
      border-radius: var(--radius);
      order: 3;
    }
    .nav-btn span {
      display: block;
      width: 20px;
      height: 2px;
      background: var(--ink);
      margin: 0 auto;
      transition: transform 0.18s var(--ease-out), opacity 0.18s var(--ease-out);
    }
    .nav-toggle:checked + .nav-btn span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
    .nav-toggle:checked + .nav-btn span:nth-child(2) { opacity: 0; }
    .nav-toggle:checked + .nav-btn span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

    .site-nav {
      position: absolute;
      top: 66px;
      left: 0;
      right: 0;
      background: var(--white);
      border-bottom: 1px solid var(--line);
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 8px 0;
      margin: 0;
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.2s var(--ease-out);
    }
    .site-nav a {
      padding: 14px 20px;
      min-height: 48px;
      display: flex;
      align-items: center;
      border-bottom: 1px solid var(--line-soft);
    }
    .site-nav a:last-child { border-bottom: none; }

    .nav-toggle:checked ~ .site-nav {
      max-height: 300px;
    }

    .shop-pill { order: 2; }
  }
</style>
