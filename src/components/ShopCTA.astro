---
// ShopCTA — dark variant, inline in article
// Note: url currently disabled (no navigation) per user request until shop is connected
export interface Props {
  title: string;
  sub: string;
  eyebrow?: string;
}
const { title, sub, eyebrow = 'Sklep' } = Astro.props;
---

<div class="shop-cta">
  <div class="shop-cta-thumb placeholder-pattern-dark" aria-hidden="true"></div>
  <div class="shop-cta-body">
    <div class="shop-cta-eyebrow">{eyebrow}</div>
    <div class="shop-cta-title">{title}</div>
    <div class="shop-cta-sub">{sub}</div>
  </div>
  <span class="shop-cta-action" aria-label={`Zobacz w sklepie: ${title}`}>
    Zobacz w sklepie
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M7 17L17 7M17 7H8M17 7v9"/>
    </svg>
  </span>
</div>

<style>
  .shop-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 22px;
    background: var(--ink);
    border-radius: var(--radius-lg);
    padding: 26px 28px;
    margin: 36px 0;
    font-family: var(--font-ui);
    color: var(--white);
  }

  .shop-cta-thumb {
    flex: 0 0 auto;
    width: 88px;
    height: 88px;
    border-radius: 8px;
  }

  .placeholder-pattern-dark {
    background-color: var(--ink-soft);
    background-image: repeating-linear-gradient(135deg, rgba(255,255,255,0.06) 0 8px, transparent 8px 16px);
  }

  .shop-cta-body {
    flex: 1 1 220px;
    min-width: 0;
  }

  .shop-cta-eyebrow {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--orange);
  }

  .shop-cta-title {
    margin-top: 10px;
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.3px;
    color: var(--white);
  }

  .shop-cta-sub {
    margin-top: 8px;
    font-size: 14px;
    line-height: 1.55;
    color: #B8B8B8;
    text-wrap: pretty;
  }

  .shop-cta-action {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 48px;
    padding: 0 22px;
    font-size: 14px;
    font-weight: 600;
    border-radius: var(--radius);
    background: var(--orange);
    color: var(--ink);
    cursor: default;
  }

  @media (max-width: 600px) {
    .shop-cta { padding: 22px; gap: 16px; }
    .shop-cta-thumb { width: 64px; height: 64px; }
    .shop-cta-body { flex-basis: 100%; order: 2; }
    .shop-cta-action { align-self: stretch; justify-content: center; order: 3; }
  }
</style>
