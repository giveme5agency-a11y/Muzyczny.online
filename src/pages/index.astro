---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import LandingCard from '../components/LandingCard.astro';
import Newsletter from '../components/Newsletter.astro';

const landings = (await getCollection('landings', ({ data }) => data.published))
  .sort((a, b) => b.data.updated.getTime() - a.data.updated.getTime());

const featured = landings[0];
const rest = landings.slice(1, 7);
---

<BaseLayout
  title="Instrumenty muzyczne — poradniki i przewodniki zakupowe · muzyczny.online"
  description="Praktyczne poradniki jak wybrać instrument muzyczny — dla dzieci, akustyczne, używane, ukulele. 35 lat doświadczenia z realnej sprzedaży."
>
  <!-- Hero -->
  <section class="hero">
    <div class="wrap hero-inner">
      <div>
        <span class="hero-eyebrow">Muzyczny.online</span>
        <h1>Wybór instrumentu bez chodzenia po sklepach</h1>
        <p>
          Poradniki napisane przez ludzi, którzy sprzedali tysiące instrumentów.
          Bez ściemy, bez marketingowego blichtru — tylko to, co realnie decyduje,
          czy dziecko dalej gra po pół roku.
        </p>
        <div class="hero-actions">
          <a href="#poradniki" class="btn btn-primary">Przeglądaj poradniki</a>
          <span class="btn btn-ink btn-static">Sklep</span>
        </div>
      </div>
     <div class="hero-art" aria-hidden="true">
  <img src="/heroes/dziewczynka.jpg" alt="" />
</div>
    </div>
  </section>

  <!-- Poradniki -->
  <section id="poradniki" class="section-poradniki">
    <div class="wrap">
      <div class="section-head">
        <h2>Najnowsze poradniki</h2>
        <a href="/poradniki/">Wszystkie</a>
      </div>

      <div class="landing-grid">
        {featured && (
          <LandingCard
            title={featured.data.title}
            description={featured.data.description}
            href={`/${featured.slug}/`}
            readingTime={featured.data.readingTime}
            category={featured.data.category}
            hero={featured.data.hero}
            featured={true}
          />
        )}
        {rest.map((landing) => (
          <LandingCard
            title={landing.data.title}
            description={landing.data.description}
            href={`/${landing.slug}/`}
            readingTime={landing.data.readingTime}
            category={landing.data.category}
            hero={landing.data.hero}
          />
        ))}
      </div>
    </div>
  </section>

  <Newsletter />
</BaseLayout>

<style>
  /* ============ Hero ============ */
  .hero {
    background: var(--ink);
    color: var(--white);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(340px, 1fr) minmax(340px, 1fr);
    gap: 48px;
    align-items: center;
    padding: 88px 20px 92px;
  }

  .hero-eyebrow {
    display: inline-block;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--orange);
    border: 1px solid rgba(245, 143, 0, 0.45);
    border-radius: 4px;
    padding: 7px 12px;
  }

  .hero h1 {
    margin: 26px 0 0;
    font-size: 46px;
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: -1px;
    color: var(--white);
    text-wrap: pretty;
    max-width: 560px;
  }

  .hero p {
    margin: 22px 0 0;
    max-width: 480px;
    font-family: var(--font-serif);
    font-size: 19px;
    line-height: 1.6;
    color: #B8B8B8;
    text-wrap: pretty;
  }

  .hero-actions {
    margin-top: 34px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .btn-static {
    cursor: default;
  }

 .hero-art {
  aspect-ratio: 4 / 3;
  border-radius: var(--radius-lg);
  overflow: hidden;
  min-height: 300px;
}

.hero-art img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

  /* ============ Poradniki section ============ */
  .section-poradniki {
    padding: 76px 0 84px;
  }

  .landing-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 22px;
  }

  @media (max-width: 900px) {
    .hero-inner { grid-template-columns: 1fr; padding: 56px 20px 60px; gap: 32px; }
    .hero h1 { font-size: 34px; letter-spacing: -0.6px; }
    .hero p { font-size: 17px; }
    .hero-art { min-height: 220px; }
    .section-poradniki { padding: 48px 0 60px; }
  }

  @media (max-width: 560px) {
    .hero h1 { font-size: 28px; }
    .hero p { font-size: 16px; }
    .landing-grid { grid-template-columns: 1fr; }
  }
</style>
