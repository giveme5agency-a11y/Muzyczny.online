---
import BaseLayout from './BaseLayout.astro';
import ShopCTA from '../components/ShopCTA.astro';
import BridgeCTA from '../components/BridgeCTA.astro';
import AuthorBio from '../components/AuthorBio.astro';
import TableOfContents from '../components/TableOfContents.astro';
import Faq from '../components/Faq.astro';
import RelatedPosts from '../components/RelatedPosts.astro';

export interface Props {
  frontmatter: {
    title: string;
    h1?: string;
    description: string;
    keyword: string;
    category: string;
    readingTime: number;
    updated: Date;
    hero?: string;
    lead?: string;
    faq?: Array<{ q: string; a: string }>;
    ctaCategories?: Array<{ label: string; sub: string; url?: string }>;
    keyTakeaways?: string[];
  };
  slug: string;
  headings: Array<{ depth: number; slug: string; text: string }>;
  related?: Array<{ title: string; href: string; category: string; readingTime: number }>;
}

const { frontmatter, slug, headings, related = [] } = Astro.props;
const {
  title,
  h1 = title,
  description,
  category,
  readingTime,
  updated,
  hero,
  lead,
  faq = [],
  ctaCategories = [],
  keyTakeaways = [],
} = frontmatter;

const updatedISO = updated.toISOString().split('T')[0];
const updatedFormatted = updated.toLocaleDateString('pl-PL', { year: 'numeric', month: 'long' });
const canonical = `https://muzyczny.online/${slug}/`;

// Build TOC extra items (Kluczowe wnioski + FAQ get anchors too)
const tocExtras = [];
if (keyTakeaways.length > 0) tocExtras.push({ slug: 'wnioski', text: 'Kluczowe wnioski' });
if (faq.length > 0) tocExtras.push({ slug: 'faq', text: 'Najczęstsze pytania' });

// Schemas
const faqSchema = faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
} : null;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: h1,
  description,
  datePublished: updated.toISOString(),
  dateModified: updated.toISOString(),
  author: { '@type': 'Organization', name: 'muzyczny.online' },
  publisher: {
    '@type': 'Organization',
    name: 'muzyczny.online',
    logo: { '@type': 'ImageObject', url: 'https://muzyczny.online/favicon.svg' },
  },
  mainEntityOfPage: canonical,
  ...(hero && { image: `https://muzyczny.online${hero}` }),
};

const primaryCta = ctaCategories[0];
---

<BaseLayout title={`${title} — muzyczny.online`} description={description} canonical={canonical} ogImage={hero}>

  <nav aria-label="Breadcrumbs" class="crumbs">
    <div class="crumbs-inner">
      <a href="/">Strona główna</a>
      <span aria-hidden="true">/</span>
      <a href="/poradniki/">Poradniki</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{title}</span>
    </div>
  </nav>

  <article>
    <div class="wrap-narrow article-head">
      <div class="article-meta">
        <span class="article-cat">{category}</span>
        <span class="article-sep">|</span>
        <span class="article-time">{readingTime} min czytania</span>
        <span class="article-sep">|</span>
        <span>Aktualizacja: <time datetime={updatedISO}>{updatedFormatted}</time></span>
      </div>

      <h1>{h1}</h1>

      {lead && <p class="article-lead">{lead}</p>}

      <AuthorBio />

      <TableOfContents headings={headings} extraItems={tocExtras} />
    </div>

    <div class="wrap-narrow prose">
      <slot />

      {primaryCta && (
        <ShopCTA title={primaryCta.label} sub={primaryCta.sub} />
      )}

      {keyTakeaways.length > 0 && (
        <div id="wnioski" class="takeaways">
          <h2>Kluczowe wnioski</h2>
          <ul>
            {keyTakeaways.map((item) => (
              <li set:html={item} />
            ))}
          </ul>
        </div>
      )}
    </div>
  </article>

  {faq.length > 0 && <Faq items={faq} />}

  {ctaCategories.length > 0 && (
    <div class="wrap-narrow bridge-wrap">
      <BridgeCTA items={ctaCategories} />
    </div>
  )}

  {related.length > 0 && <RelatedPosts posts={related} />}

  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
</BaseLayout>

<style>
  /* ============ Breadcrumbs ============ */
  .crumbs {
    border-bottom: 1px solid var(--line);
  }
  .crumbs-inner {
    max-width: var(--container-narrow);
    margin: 0 auto;
    padding: 14px 20px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: var(--text-muted);
  }
  .crumbs-inner a { color: var(--text-muted); }
  .crumbs-inner a:hover { color: var(--orange-dark); }
  .crumbs-inner > span:not([aria-current]) { color: var(--line-quiet); }
  .crumbs-inner [aria-current] { color: var(--text-quiet); }

  /* ============ Article head ============ */
  .article-head {
    padding-top: 46px;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .article-cat { color: var(--orange-dark); }
  .article-time, .article-meta > span { color: var(--text-quiet); }
  .article-cat { color: var(--orange-dark); }
  .article-sep { color: var(--line); }

  .article-head h1 {
    margin: 16px 0 0;
    font-size: 40px;
    line-height: 1.12;
    font-weight: 700;
    letter-spacing: -1.1px;
    color: var(--ink);
    text-wrap: pretty;
  }

  .article-lead {
    margin: 22px 0 0;
    font-family: var(--font-serif);
    font-size: 20px;
    line-height: 1.6;
    font-weight: 600;
    color: var(--ink);
    text-wrap: pretty;
  }

  /* ============ Prose ============ */
  .prose {
    margin-top: 40px;
    font-family: var(--font-serif);
    font-size: 17px;
    line-height: 1.65;
    color: var(--text);
  }

  .prose :global(p) {
    margin: 0 0 18px;
    text-wrap: pretty;
  }

  .prose :global(strong) {
    font-weight: 600;
    color: var(--ink);
  }

  .prose :global(a) {
    color: var(--orange-dark);
    border-bottom: 1px solid var(--orange-tint);
    transition: border-color 0.15s;
  }

  .prose :global(a:hover) { border-bottom-color: var(--orange); }

  .prose :global(h2) {
    font-family: var(--font-ui);
    font-size: 25px;
    font-weight: 600;
    letter-spacing: -0.4px;
    color: var(--ink);
    margin: 52px 0 14px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    scroll-margin-top: 80px;
    text-wrap: pretty;
  }

  .prose :global(h3) {
    font-family: var(--font-ui);
    font-size: 19px;
    font-weight: 600;
    color: var(--ink);
    margin: 32px 0 12px;
    scroll-margin-top: 80px;
  }

  .prose :global(ul), .prose :global(ol) {
    margin: 0 0 18px;
    padding-left: 22px;
  }

  .prose :global(li) { margin-bottom: 8px; }

  .prose :global(blockquote) {
    border-left: 3px solid var(--orange);
    padding: 4px 0 4px 20px;
    margin: 24px 0;
    color: var(--text-muted);
    font-style: italic;
  }

  /* Tables — wrap in figure via markdown or use raw table */
  .prose :global(table) {
    width: 100%;
    min-width: 560px;
    border-collapse: collapse;
    font-family: var(--font-ui);
    font-size: 14px;
  }

  .prose :global(.table-wrap) {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: 8px;
    margin: 26px 0 8px;
  }

  .prose :global(figure) {
    margin: 26px 0 30px;
  }

  .prose :global(figcaption) {
    margin-top: 10px;
    font-family: var(--font-ui);
    font-size: 12px;
    line-height: 1.5;
    color: var(--text-muted);
  }

  .prose :global(th), .prose :global(td) {
    padding: 13px 14px;
    text-align: left;
    border-bottom: 1px solid var(--line-soft);
  }

  .prose :global(th) {
    background: var(--cream);
    border-bottom-color: var(--line);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* ============ Kluczowe wnioski ============ */
  .takeaways {
    margin: 44px 0 0;
    background: var(--cream);
    border-radius: var(--radius-lg);
    padding: 26px 28px;
    scroll-margin-top: 80px;
  }

  .takeaways h2 {
    margin: 0;
    font-family: var(--font-ui);
    font-size: 18px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--ink);
    border: none;
    padding: 0;
  }

  .takeaways ul {
    margin: 14px 0 0;
    padding-left: 22px;
    font-family: var(--font-serif);
    font-size: 16px;
    line-height: 1.6;
  }

  .takeaways li { margin-bottom: 8px; }
  .takeaways li:last-child { margin-bottom: 0; }
  .takeaways :global(strong) { font-weight: 600; color: var(--ink); }

  /* ============ Bridge wrap ============ */
  .bridge-wrap {
    padding-top: 0;
  }

  @media (max-width: 780px) {
    .article-head { padding-top: 32px; }
    .article-head h1 { font-size: 30px; letter-spacing: -0.6px; }
    .article-lead { font-size: 18px; }
    .prose { font-size: 16px; }
    .prose :global(h2) { font-size: 22px; margin-top: 40px; }
    .prose :global(h3) { font-size: 17px; }
  }
</style>
